    <!-- Circuit/Tech nodes -->
    <circle
        android:cx="380"
        android:cy="450"
        android:r="20"
        android:fillColor="#1fb5d6"
        android:strokeColor="#0d6b88"
        android:strokeWidth="6" />

    <circle
        android:cx="550"
        android:cy="350"
        android:r="20"
        android:fillColor="#1fb5d6"
        android:strokeColor="#0d6b88"
        android:strokeWidth="6" />

    <circle
        android:cx="650"
        android:cy="500"
        android:r="20"
        android:fillColor="#1fb5d6"
        android:strokeColor="#0d6b88"
        android:strokeWidth="6" />

    <circle
        android:cx="750"
        android:cy="380"
        android:r="20"
        android:fillColor="#1fb5d6"
        android:strokeColor="#0d6b88"
        android:strokeWidth="6" />

    <!-- Circuit connecting lines -->
    <line
        android:x1="380"
        android:y1="450"
        android:x2="550"
        android:y2="350"
        android:strokeColor="#1fb5d6"
        android:strokeWidth="6"

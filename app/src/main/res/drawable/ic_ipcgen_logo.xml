        android:strokeLineCap="round" />

    <line
        android:x1="650"
        android:y1="500"
        android:x2="750"
        android:y2="380"
        android:strokeColor="#1fb5d6"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Bottom bar -->
    <path
        android:pathData="M 300 600 L 800 600 L 750 660 L 350 660 Z"
        android:fillColor="#b8f3ff"
        android:fillAlpha="0.85" />
</vector>

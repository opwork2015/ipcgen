<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="192dp"
    android:height="192dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Background -->
    <path
        android:pathData="M 0 0 L 1024 0 L 1024 1024 L 0 1024 Z"
        android:fillColor="#e8f4f8" />

    <!-- Shield with gradient effect using multiple paths -->
    <!-- Shield outline -->
    <path
        android:pathData="M 380 180 L 650 80 L 800 150 L 800 520 C 800 760 620 900 500 970 C 380 900 200 760 200 520 L 200 150 Z"
        android:fillColor="#3dd9f7"
        android:strokeColor="#0d6b88"

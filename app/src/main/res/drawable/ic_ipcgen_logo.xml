    <!-- Shield darker overlay -->
    <path
        android:pathData="M 380 220 L 620 120 L 750 180 L 750 540 C 750 720 600 840 500 900 C 400 840 250 720 250 540 L 250 180 Z"
        android:fillColor="#1b9fc5" />

    <!-- Folder/Document shapes -->
    <path
        android:pathData="M 300 500 L 520 300 L 680 300 L 480 500 Z"
        android:fillColor="#d0f8ff"
        android:fillAlpha="0.9" />

    <path
        android:pathData="M 400 250 L 540 250 L 620 340 L 480 340 Z"
        android:fillColor="#a8f0ff"
        android:fillAlpha="0.8" />

    <!-- Arrow pointing up right -->
    <path
        android:pathData="M 700 200 L 900 400 L 800 400 L 950 580 L 850 580 L 750 680 L 650 350 Z"
        android:fillColor="#1ba3d4"
        android:strokeColor="#0d5a6e"
